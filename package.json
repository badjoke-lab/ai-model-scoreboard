{
  "name": "ai-model-scoreboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:routes && npm run typecheck && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-route-safety.js",
    "check:v4": "node scripts/check_v4_snapshot.mjs",
    "ci": "npm run check:routes && npm run typecheck && next build",
    "v4:validate-output": "node scripts/v4-validate-output.js",
    "v4:verify": "npm run v4:normalize-public && npm run v4:validate-output && npm run check:v4",
    "validate:v4": "node scripts/validate-v4-models.js",
    "v4:normalize-public": "node scripts/v4-normalize-public.js",
    "v4:diff-modelset": "node scripts/v4-diff-modelset.js",
    "spec:v4": "SPEC_V4_FIXTURES=1 node scripts/spec-assert-v4.js",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "vitest": "^2.1.8"
  }
}
