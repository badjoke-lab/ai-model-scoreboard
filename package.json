{
  "name": "ai-model-scoreboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run check:routes && npm run typecheck && next build",
    "start": "next start",
    "lint": "next lint",
    "snapshot": "node scripts/snapshot_v4.mjs",
    "typecheck": "tsc --noEmit",
    "check:routes": "node scripts/check-route-safety.js",
    "check:v4": "node scripts/check_v4_snapshot.mjs",
    "ci": "npm run check:routes && npm run typecheck && next build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "next": "14.2.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.3",
    "@playwright/test": "^1.46.1"
  }
}
